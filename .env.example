# ---------- Site ----------
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Contact form needs NO keys: it emails asemmostafa35@gmail.com via FormSubmit (activate once, see README).

# ---------- Admin dashboard (/dashboard) ----------
# REQUIRED in production. In development defaults are admin@asem.com / Admin@123456.
ADMIN_EMAIL=admin@asem.com
ADMIN_PASSWORD=
# Long random string used to sign the session cookie:  openssl rand -base64 32
AUTH_SECRET=

# ---------- Project storage on Vercel (optional but needed there) ----------
# Upstash Redis (or Vercel KV) REST credentials. Without these, projects are stored in data/projects.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
